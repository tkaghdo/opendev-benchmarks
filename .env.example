# Warehouse
DATABASE_URL=postgres://opendev:opendev@localhost:5432/opendev

# GitHub ingestion (worker only — never expose to the Next.js browser bundle)
GITHUB_TOKEN=

# Ingestion window and schedule
LOOKBACK_DAYS=365
INGEST_INTERVAL_HOURS=4
INGEST_HEALTH_PORT=8081

# Cube YAML in this repo is a handoff into Embedded Canvas Cube — not a runtime OpenDev operates.
CUBE_API_URL=http://localhost:4000/cubejs-api/v1
CUBE_API_SECRET=dev-cube-secret-change-me

# Embedded Canvas. Server-only except NEXT_PUBLIC_* embed tokens.
# Fill these after you register chromeless dashboards (see docs/OPERATOR-EMBED.md).
EMBEDDED_CANVAS_API_URL=
EMBEDDED_CANVAS_APP_URL=
NEXT_PUBLIC_EMBED_ORIGIN=
EMBED_API_KEY=
EMBED_TOKEN=
NEXT_PUBLIC_EMBED_TOKEN=
# Optional per-slot tokens (fallback is NEXT_PUBLIC_EMBED_TOKEN).
# Inlined at `pnpm build` — rebuild after changing any NEXT_PUBLIC_* value.
# NEXT_PUBLIC_EMBED_TOKEN_OVERVIEW=
# NEXT_PUBLIC_EMBED_TOKEN_DELIVERY=
# NEXT_PUBLIC_EMBED_TOKEN_DELIVERY_THROUGHPUT=
# NEXT_PUBLIC_EMBED_TOKEN_ISSUES=
# NEXT_PUBLIC_EMBED_TOKEN_CONTRIBUTORS=
# NEXT_PUBLIC_EMBED_TOKEN_REPOS=
# NEXT_PUBLIC_EMBED_TOKEN_COLLABORATION=
# NEXT_PUBLIC_EMBED_TOKEN_COMPARE=
# NEXT_PUBLIC_EMBED_TOKEN_CUSTOMER=
# NEXT_PUBLIC_EMBED_TOKEN_INTERNAL=
