{
  "name": "opendev-benchmarks",
  "private": true,
  "description": "OpenDev Benchmarks — public developer analytics powered by Embedded Canvas",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @opendev/web dev",
    "build": "pnpm --filter @opendev/web build",
    "dev:ingest": "pnpm --filter @opendev/ingestion dev",
    "ingest": "pnpm --filter @opendev/ingestion start",
    "ingest:loop": "pnpm --filter @opendev/ingestion start:loop",
    "ingest:quality": "pnpm --filter @opendev/ingestion quality",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "stack:up": "docker compose up -d",
    "cube:up": "docker compose up -d postgres cube",
    "cube:golden": "pnpm --filter @opendev/ingestion golden"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp"]
  }
}
